# --- AI (free): https://console.groq.com/keys  — leave empty to run in rules-only mode
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_FAST_MODEL=llama-3.1-8b-instant

# --- Signs the client-held conversation state. Use a long random string in production.
SESSION_SECRET=change-me

# --- Staff dashboard access code
ADMIN_TOKEN=demo

# --- Database: empty = local SQLite file. On Vercel use Postgres (e.g. Neon free tier).
DATABASE_URL=

# --- Google Calendar (optional): service-account JSON (raw or base64) + the calendar id you shared with it
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_CALENDAR_ID=
